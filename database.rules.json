
{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','username','usernameKey','email','plan','role','subscriptionStatus','createdAt','lastSeenAt','active','currentProduct'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 24"
        },
        "plan": {
          ".validate": "newData.isString()"
        },
        "role": {
          ".validate": "newData.isString()"
        },
        "subscriptionStatus": {
          ".validate": "newData.isString()"
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','username']) && newData.child('uid').val() === auth.uid"
      }
    }
  }
}
